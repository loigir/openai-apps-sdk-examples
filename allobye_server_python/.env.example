# Supabase Configuration
# Get these values from your Supabase project settings
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_PROJECT_REF=xxxxxxxxxxxxx

# Supabase Keys
# CRITICAL: Never commit real keys to version control
# Get these from: Project Settings > API > Project API keys
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key_placeholder
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_key_placeholder

# Database Connection
# Get from: Project Settings > Database > Connection string
DATABASE_URL=postgresql://postgres:your_password_here@db.xxxxxxxxxxxxx.supabase.co:5432/postgres
SUPABASE_DB_PASSWORD=your_password_here

# Motion+ API
# Optional: Only needed if using Motion+ integration
MOTION_PLUS_API_KEY=your_motion_api_key_here

# Environment Configuration (optional)
ENVIRONMENT=production
LOG_LEVEL=INFO
